# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit it.

# MongoDB Atlas connection string (Connect → Drivers in Atlas)
# Format: mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Database name (Atlas creates it on first write)
MONGODB_DB=radar

# FRED API key — request at https://fredaccount.stlouisfed.org/apikeys
# Not required for Phase 2 v0.1 (DolarAPI + CoinGecko only), but wire it in now.
FRED_API_KEY=

# Shared secret to authorize cron and admin routes.
# Generate any random string, e.g.: openssl rand -hex 32
# Paste the same value in Vercel → Settings → Environment Variables.
CRON_SECRET=
